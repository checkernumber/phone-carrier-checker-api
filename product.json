{
  "name": "Global Carrier Checker API",
  "brand": "CheckNumber",
  "slug": "phone-carrier-checker-api",
  "repository": "checkernumber/phone-carrier-checker-api",
  "description": "Asynchronous file-based Global Carrier Checker checks.",
  "official_site": "https://checknumber.ai",
  "landing_page": "https://checknumber.ai/products/global-carrier-checker",
  "canonical_docs": "https://docs.checknumber.ai/phone-carrier-bulk-checker",
  "dashboard": "https://platform.checknumber.ai",
  "base_url": "https://api.checknumber.ai",
  "mode": "async",
  "auth": {
    "type": "api_key",
    "header": "X-API-Key"
  },
  "endpoints": {
    "create_task": {
      "method": "POST",
      "path": "/v1/tasks"
    },
    "get_task": {
      "method": "POST",
      "path": "/v1/gettasks"
    },
    "balance": {
      "method": "GET",
      "path": "/v1/balance"
    }
  },
  "input": {
    "file_format": "text file, one E.164 phone number per line according to task type"
  },
  "products": [
    {
      "task_type": "usaCarrier",
      "name": "Global Carrier Checker",
      "doc_slug": "phone-carrier-bulk-checker",
      "input_kind": "phone",
      "min_numbers": 1,
      "max_numbers": 10000000,
      "result_fields": [
        "number",
        "number_type",
        "country_code",
        "carrier",
        "underlying_carrier",
        "region",
        "city"
      ],
      "product_id": 26,
      "min_billable_numbers": 500,
      "available": true
    }
  ],
  "pricing_url": "https://checknumber.ai/pricing",
  "maintainer": "CheckNumber",
  "license": "MIT",
  "last_reviewed": "2026-10-30"
}
